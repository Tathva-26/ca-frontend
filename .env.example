# Origin of the backend, with no trailing slash.
#
# This origin must also be listed in the backend's ALLOWED_ORIGINS. That list
# fails closed: reads from an unlisted origin are blocked by CORS, and writes
# come back as a plain 403 {"error":"Forbidden"} from the backend's own origin
# check rather than as a CORS error.
NEXT_PUBLIC_BACKEND_URL=https://api.tathva.org

# Dashboard sections that are not backed by this API.
#
# Posters and feedback run on Google Apps Script and Firebase, so they are off
# unless their own configuration is in place. Referrals are always on — they
# are served by /api/referrals.
NEXT_PUBLIC_SECTION_POSTERS=false
NEXT_PUBLIC_SECTION_FEEDBACK=false

# Set to show the "join the WhatsApp group" dashboard section.
# NEXT_PUBLIC_WHATSAPP_LINK=https://chat.whatsapp.com/...

# Where referral links should land: the main site, which is where events are
# booked and where the ?referral_code= parameter is read.
NEXT_PUBLIC_MAIN_SITE_URL=https://tathva.org
